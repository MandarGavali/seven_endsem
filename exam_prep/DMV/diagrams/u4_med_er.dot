digraph G { graph [fontname="Helvetica", fontsize=12, nodesep=0.4, ranksep=0.6, pad=0.2]; node [shape=plaintext, fontname="Helvetica", fontsize=12]; edge [color="#1F3A68", fontname="Helvetica", fontsize=11, dir=none]; rankdir=TB;
PATIENT [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EAF1FB"><tr><td bgcolor="#1F3A68"><font color="white"><b>PATIENT</b></font></td></tr><tr><td align="left"><u>patient_id</u> (PK)</td></tr><tr><td align="left">name, dob, gender</td></tr></table>>];
STUDY [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EAF1FB"><tr><td bgcolor="#1F3A68"><font color="white"><b>STUDY</b></font></td></tr><tr><td align="left"><u>study_uid</u> (PK)</td></tr><tr><td align="left">patient_id (FK)</td></tr><tr><td align="left">date, modality, physician_id (FK)</td></tr></table>>];
SERIES [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EAF1FB"><tr><td bgcolor="#1F3A68"><font color="white"><b>SERIES</b></font></td></tr><tr><td align="left"><u>series_uid</u> (PK)</td></tr><tr><td align="left">study_uid (FK)</td></tr><tr><td align="left">body_part, protocol</td></tr></table>>];
IMAGE [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EAF1FB"><tr><td bgcolor="#1F3A68"><font color="white"><b>IMAGE</b></font></td></tr><tr><td align="left"><u>sop_uid</u> (PK)</td></tr><tr><td align="left">series_uid (FK)</td></tr><tr><td align="left">file_path, slice_no, pixel_spacing</td></tr></table>>];
FINDING [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EAF1FB"><tr><td bgcolor="#1F3A68"><font color="white"><b>FINDING</b></font></td></tr><tr><td align="left"><u>finding_id</u> (PK)</td></tr><tr><td align="left">sop_uid (FK)</td></tr><tr><td align="left">label, ROI, SUV / volume</td></tr></table>>];
PHYSICIAN [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EAF1FB"><tr><td bgcolor="#1F3A68"><font color="white"><b>PHYSICIAN</b></font></td></tr><tr><td align="left"><u>physician_id</u> (PK)</td></tr><tr><td align="left">name, department</td></tr></table>>];
PATIENT->STUDY [label="1 : N"]; STUDY->SERIES [label="1 : N"]; SERIES->IMAGE [label="1 : N"]; IMAGE->FINDING [label="1 : N"]; PHYSICIAN->STUDY [label="1 : N"];
}