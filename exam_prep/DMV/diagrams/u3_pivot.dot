digraph G { graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=0.5, pad=0.2]; node [shape=plaintext, fontname="Helvetica", fontsize=13]; edge [color="#1F3A68", fontname="Helvetica", fontsize=12, penwidth=1.3]; rankdir=LR;
L [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF"><tr><td colspan="3"><b>Raw orders</b></td></tr><tr><td>Product</td><td>Country</td><td>Amount</td></tr><tr><td>Apple</td><td>India</td><td>40</td></tr><tr><td>Banana</td><td>India</td><td>30</td></tr><tr><td>Apple</td><td>UK</td><td>25</td></tr><tr><td>Apple</td><td>India</td><td>10</td></tr><tr><td>Banana</td><td>UK</td><td>45</td></tr></table>>];
P [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFE9B3"><tr><td colspan="4"><b>Pivot table: Sum of Amount</b></td></tr><tr><td>Product \\ Country</td><td>India</td><td>UK</td><td><b>Total</b></td></tr><tr><td>Apple</td><td>50</td><td>25</td><td><b>75</b></td></tr><tr><td>Banana</td><td>30</td><td>45</td><td><b>75</b></td></tr><tr><td><b>Total</b></td><td><b>80</b></td><td><b>70</b></td><td><b>150</b></td></tr></table>>];
L->P [label="index = Product\ncolumns = Country\nvalues = Amount\naggfunc = sum"];
}
