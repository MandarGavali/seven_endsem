digraph G { graph [fontname="Helvetica", fontsize=13, nodesep=0.3, ranksep=0.5, pad=0.2]; node [shape=plaintext, fontname="Helvetica", fontsize=13]; edge [color="#1F3A68", fontname="Helvetica", fontsize=12, penwidth=1.3]; rankdir=LR;
D [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFFFFF"><tr><td colspan="2"><b>Data</b></td></tr><tr><td>key</td><td>sales</td></tr><tr><td>A</td><td>10</td></tr><tr><td>B</td><td>5</td></tr><tr><td>A</td><td>20</td></tr><tr><td>C</td><td>8</td></tr><tr><td>B</td><td>15</td></tr><tr><td>C</td><td>2</td></tr></table>>];
A [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#EAF1FB"><tr><td colspan="2"><b>A</b></td></tr><tr><td>A</td><td>10</td></tr><tr><td>A</td><td>20</td></tr></table>>];
B [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#EAF1FB"><tr><td colspan="2"><b>B</b></td></tr><tr><td>B</td><td>5</td></tr><tr><td>B</td><td>15</td></tr></table>>];
C [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#EAF1FB"><tr><td colspan="2"><b>C</b></td></tr><tr><td>C</td><td>8</td></tr><tr><td>C</td><td>2</td></tr></table>>];
a [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFF6DD"><tr><td>A</td><td>30</td></tr></table>>]; b [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFF6DD"><tr><td>B</td><td>20</td></tr></table>>]; c [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFF6DD"><tr><td>C</td><td>10</td></tr></table>>];
R [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#FFE9B3"><tr><td colspan="2"><b>Result</b></td></tr><tr><td>key</td><td>sum</td></tr><tr><td>A</td><td>30</td></tr><tr><td>B</td><td>20</td></tr><tr><td>C</td><td>10</td></tr></table>>];
D->B [label="SPLIT\nby key"]; D->A; D->C; A->a [label="APPLY\nsum()"]; B->b; C->c; b->R [label="COMBINE"]; a->R; c->R;
}
